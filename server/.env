DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nehramsdb
SERVER_PORT=5000
NODE_ENV=development
ENABLE_AI_SUMMARY=false
ENABLE_AI_ERROR_FALLBACK=true


# Email Configuration (SMTP)
# Option 1: Gmail (Recommended for development)
# Create App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=nherams@healthcare.gov.ng
# SMTP_FROM_NAME="NHERAMS Portal"

# Option 2: nountutor.com.ng (Production - requires clearing mailbox)
SMTP_HOST=mail.nountutor.com.ng
SMTP_PORT=465
SMTP_USER=info@nountutor.com.ng
SMTP_PASSWORD=@@NounInfo22!!
SMTP_FROM_EMAIL=info@nountutor.com.ng
SMTP_FROM_NAME="NHERAMS Portal"


# JWT Configuration
JWT_SECRET=nherams-super-secret-key-change-in-production-2026
JWT_EXPIRE=7d

# Email Verification
EMAIL_VERIFICATION_TOKEN_EXPIRE=24h
VERIFICATION_BASE_URL=http://localhost:3000

SUPER_ADMIN_EMAIL=super@nherams.org
SUPER_ADMIN_PASSWORD=SuperAdmin@123